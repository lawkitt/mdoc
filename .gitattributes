# PDF cross-reference tables contain fixed-width records; do not text-normalize.
*.pdf binary

# Generated license quotations retain upstream whitespace.
THIRD-PARTY-LICENSES.html -whitespace

# Bundled Hunspell dictionaries are kept byte-for-byte (digests in their README).
crates/mdoc-spell/dictionaries/*.aff -text
crates/mdoc-spell/dictionaries/*.dic -text

# Captured AI replies and the demos they were made from are compared byte for
# byte (ADR 0056): keep LF on Windows.
tests/fixtures/restore/** text eol=lf
docs/product-media/*.md text eol=lf
# Mobile parity goldens (ADR 0085), compared byte for byte the same way.
tests/fixtures/mobile-parity/** text eol=lf

# Shell scripts and the tool pins they source keep LF on Windows too:
# shellcheck rejects CRLF, and a sourced CR ends up in variable values.
*.sh text eol=lf
scripts/tools.env text eol=lf
# The area table (ADR 0091): read line by line on every runner.
scripts/ci-areas.txt text eol=lf

# The render test's screen list: parallel branches each add lines, and a
# union merge keeps both (ADR 0082).
tests/headless_screens.txt merge=union text eol=lf

# Recognition fixtures (ADR 0093): byte offsets and snapshots assume LF.
tests/fixtures/recognition/** text eol=lf
