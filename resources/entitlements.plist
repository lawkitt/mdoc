<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the macOS bundle (cargo-packager signs
  with the hardened runtime). OCR and pseudonymization dlopen PDFium and ONNX
  Runtime, downloaded at first use and signed by their own vendors; library
  validation would refuse them ("code signature ... not valid for use in
  process"). Notarization accepts this entitlement.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
