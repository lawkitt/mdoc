# Pinned tool versions shared by CI (.github/actions/setup) and `just setup`.
# KEY=VALUE lines only; CI appends the non-comment lines to $GITHUB_ENV.
JUST_VERSION=1.58.0
CARGO_DENY_VERSION=0.20.2
CARGO_NEXTEST_VERSION=0.9.148
CARGO_PACKAGER_VERSION=0.11.8
ACTIONLINT_VERSION=1.7.12
SHFMT_VERSION=3.14.1
ANDROID_NDK_VERSION=r29
# Two Xcode pins (ADR 0124), as `xcodebuild -version` prints them, each with
# the iOS Simulator runtime it tests on and that runtime's build, the one the
# hosted image ships (#630) and scripts/ios/ios-toolchain.sh downloads
# elsewhere: a version alone is ambiguous (26.2 resolved to the 23C52 release
# candidate, #654). Xcode is installed by hand; `just doctor` and the iOS
# jobs check it. MDOC_XCODE picks the pin (load_tools, scripts/lib.sh).
# tests: the queue's and branches' iOS tests, on hosted macos-26.
XCODE_VERSION=26.2
IOS_SIM_RUNTIME=26.2
IOS_SIM_RUNTIME_BUILD=23C54
# builds: the archive and the nightly's iOS tests, on hosted xcode-27, as App
# Store uploads need the iOS 27 SDK from April 2027 (ITMS-90725). A Mac tests
# with this Xcode on the tests' runtime: on macOS 27, Xcode 26.2's test
# runner hangs.
XCODE_BUILDS_VERSION=27.2
IOS_SIM_BUILDS_RUNTIME=27.2
IOS_SIM_BUILDS_RUNTIME_BUILD=24B8117
